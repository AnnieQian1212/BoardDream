# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai/docs/)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
DESIGNER_MODEL=muse-spark-1.3
# How long Muse Spark thinks when making a game: medium (about 3 minutes a game), low (under 2 minutes,
# but most first drafts need repairs) or default (4-5 minutes). See eval/generation/README.md.
DESIGNER_EFFORT=medium
WONDER_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Optional: Muse Spark Open on an OpenAI-compatible host plays the AI opponents when set.
# Baseten Model APIs: https://inference.baseten.co/v1. The hackathon model id is meta-models/muse-spark-open-1026.
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=
OPEN_MODEL=meta-models/muse-spark-open-1026

PORT=8787

# Optional: SMTP for the six-digit code that checks an email at sign-up. Without it a local server
# prints the code in its console, and a public demo (PUBLIC_DEMO=1) makes accounts without a code.
# Gmail: turn on 2-step verification, make an app password, and use smtp.gmail.com, port 465, your
# address as the user and the app password as the password.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# The sender shown, e.g. BoardDream <you@gmail.com>; the SMTP user when empty.
MAIL_FROM=
