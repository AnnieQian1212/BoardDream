# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai/docs/)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
DESIGNER_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Optional: Muse Spark Open on an OpenAI-compatible host plays the AI opponents when set.
# Baseten Model APIs: https://inference.baseten.co/v1. The hackathon model id is meta-models/muse-spark-open-1026.
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=
OPEN_MODEL=meta-models/muse-spark-open-1026

PORT=8787
